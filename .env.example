# ──────────────────────────────────────────────────────────────────────────────
# LegalLens-AI – Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust the values for your setup.
#
#   cp .env.example .env
#
# All AI inference runs locally through Ollama – no internet connection is
# required after the model has been downloaded.
# ──────────────────────────────────────────────────────────────────────────────

# URL of the locally running Ollama server.
# Default is correct for a standard Ollama installation on the same machine.
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for all AI inference (contract analysis + chatbot).
#
# RECOMMENDED (already downloaded, good balance of quality vs. speed):
#   phi3:latest        – 2.2 GB, Microsoft Phi-3 Mini, strong JSON following
#
# ALTERNATIVES (download with: ollama pull <name>):
#   tinyllama:latest   – 637 MB, very fast, weaker reasoning (already downloaded)
#   mistral:7b         – 4.1 GB, better reasoning, needs ≥8 GB RAM
#   llama3:8b          – 4.7 GB, strong reasoning, needs ≥8 GB RAM
#   llama3:latest      – same as llama3:8b
#   gemma2:2b          – 1.6 GB, good quality for its size
#
# To see what is already installed:  ollama list
# To download a model:               ollama pull phi3:latest
OLLAMA_MODEL=phi3:latest

# Request timeout in seconds.
# CPU-only inference on a long contract can take 2-5 minutes.
# Increase this if you see timeout errors.
OLLAMA_TIMEOUT=300
